# =============================================================================
# ezeroms.com — 環境変数テンプレート
# =============================================================================
# 使い方:
#   1. cp .env.example .env.local
#   2. 値を埋める（.env.local は Git にコミットしない）
#   3. 詳細は ENV_SETUP.md / README.md
# =============================================================================

# --- Supabase（必須） --------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# anon / public（ブラウザログイン用。RLS前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role（サーバー・移行スクリプトのみ。ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=
# Management API（npm run db:apply 等。https://supabase.com/dashboard/account/tokens）
SUPABASE_ACCESS_TOKEN=

# --- Workspace（任意・別プロジェクトにする場合のみ） -------------------------
# 未設定時は上のサイト用 Supabase（同一プロジェクト）を使う。
# 別プロジェクトに分けるときだけ両方を設定する。NEXT_PUBLIC_ は付けない。
# WORKSPACE_SUPABASE_URL=
# WORKSPACE_SUPABASE_SERVICE_ROLE_KEY=
# WORKSPACE_SUPABASE_ACCESS_TOKEN=
# WORKSPACE_PROJECT_REF=

# --- 再検証（ISR） -----------------------------------------------------------
# openssl rand -hex 32
REVALIDATE_SECRET=

# --- Vercel（任意・CLI 時） --------------------------------------------------
VERCEL_TOKEN=

# --- Contentful（移行時のみ） ------------------------------------------------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# --- Google Calendar（Workspace・読み取り専用） ------------------------------
# Google Cloud Console → OAuth 2.0 Client ID（Web application）
# Authorized redirect URI:
#   http://localhost:3000/api/admin/workspace/calendar/oauth/callback/
#   https://ezeroms.com/api/admin/workspace/calendar/oauth/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 省略時は NEXT_PUBLIC_SITE_URL + /api/admin/workspace/calendar/oauth/callback/
# GOOGLE_REDIRECT_URI=

# --- サイト ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 本番: https://ezeroms.com
# 管理画面・admin API を許可するメール（カンマ区切り）。未設定時はログイン済み全員。
ADMIN_EMAILS=

# --- Google Analytics --------------------------------------------------------
# 公開サイト測定タグ（gtag）。Hugo 時代の ID: G-K021MTL6NX
NEXT_PUBLIC_GA_ID=G-K021MTL6NX
# Admin Analytics（Data API）。測定 ID とは別の数字の Property ID。
# GA 管理画面 → 管理 → プロパティ設定 → プロパティ ID
GA_PROPERTY_ID=
# サービスアカウント（Google Cloud → IAM → サービスアカウント）
# GA4 プロパティに「閲覧者」で追加すること
GA_SERVICE_ACCOUNT_EMAIL=
# 秘密鍵（JSON の private_key。改行は \n で1行にしてもよい）
GA_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Workspace AI（提案のみ。未設定なら相談欄だけ無効） ----------------------
# OpenAI 互換 API（OpenAI / Azure OpenAI 等）
WORKSPACE_AI_API_KEY=
# 省略時: https://api.openai.com/v1
# WORKSPACE_AI_BASE_URL=
# 省略時: gpt-4o-mini
# WORKSPACE_AI_MODEL=
