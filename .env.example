# =============================================================================
# ezeroms.com — 環境変数テンプレート
# =============================================================================
# 使い方:
#   1. cp .env.example .env.local
#   2. 値を埋める（.env.local は Git にコミットしない）
#   3. 詳細は ENV_SETUP.md / README.md
# =============================================================================

# --- Supabase（必須） --------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# anon / public（ブラウザログイン用。RLS前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role（サーバー・移行スクリプトのみ。ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=

# --- 再検証（ISR） -----------------------------------------------------------
# openssl rand -hex 32
REVALIDATE_SECRET=

# --- Vercel（任意・CLI 時） --------------------------------------------------
VERCEL_TOKEN=

# --- Contentful（移行時のみ） ------------------------------------------------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# --- サイト ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
